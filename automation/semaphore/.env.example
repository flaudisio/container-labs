# Postgres
POSTGRES_DB=semaphore
POSTGRES_USER=semaphore
POSTGRES_PASSWORD=xxxxxx

# Semaphore
SEMAPHORE_WEB_ROOT=http://localhost:17300
SEMAPHORE_ADMIN=user.name
SEMAPHORE_ADMIN_NAME=User Name
SEMAPHORE_ADMIN_EMAIL=user.name@example.com
SEMAPHORE_ADMIN_PASSWORD=xxxxxx
SEMAPHORE_ACCESS_KEY_ENCRYPTION=xxxxxx
SEMAPHORE_COOKIE_HASH=xxxxxx
SEMAPHORE_COOKIE_ENCRYPTION=xxxxxx
SEMAPHORE_TELEGRAM_CHAT=-1111111111
SEMAPHORE_TELEGRAM_TOKEN=1111111111:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Runners
SEMAPHORE_RUNNER_TOKEN=xxxxxx

# Exporter
SEMAPHORE_EXPORTER_API_TOKEN=xxxxxx

# MCP server
SEMAPHORE_MCP_API_TOKEN=xxxxxx
